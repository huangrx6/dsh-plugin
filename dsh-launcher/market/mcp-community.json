    {
      "id": "mcp-sqlite",
      "name": "SQLite",
      "description": "SQLite 读写与 schema 探查；默认库文件 ~/dsh-mcp.db，可自行修改。",
      "tags": ["official", "data"],
      "author": "modelcontextprotocol",
      "version": "2025.4.7",
      "kind": "mcp",
      "payload": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-sqlite", "--db-path", "~/dsh-mcp.db"]
      }
    }
