      "tags": ["official", "reasoning"],
      "author": "modelcontextprotocol",
      "version": "2025.4.7",
      "kind": "mcp",
      "payload": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-sequentialthinking"]
      }
    },
    {
      "id": "mcp-git",
      "name": "Git",
      "description": "本地仓库操作：status / diff / log / branch / stage / commit 等。",
      "tags": ["official", "dev"],
      "author": "modelcontextprotocol",
      "version": "2025.4.7",
      "kind": "mcp",
      "payload": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-git"]
      }
    },
    {
      "id": "mcp-puppeteer",
      "name": "Puppeteer",
      "description": "无头浏览器自动化：导航、截图、点击、填表与 JS 执行。",
      "tags": ["official", "browser"],
      "author": "modelcontextprotocol",
      "version": "2025.4.7",
      "kind": "mcp",
      "payload": {
        "transport": "stdio",
        "command": "npx",
