{
  "name": "MCP 社区精选",
  "description": "modelcontextprotocol 官方参考服务器精选 —— 全部 stdio + npx 启动，安装即用，无需额外环境。",
  "version": 1,
  "items": [
    {
      "id": "mcp-fetch",
      "name": "Fetch",
      "description": "抓取网页并转为 LLM 友好的 Markdown；支持分页与重定向。",
      "tags": ["official", "web"],
      "author": "modelcontextprotocol",
      "version": "2025.4.7",
      "kind": "mcp",
      "payload": {
        "transport": "stdio",
        "command": "npx",
        "args": ["-y", "@modelcontextprotocol/server-fetch"]
      }
    },
    {
      "id": "mcp-memory",
